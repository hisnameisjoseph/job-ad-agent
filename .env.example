# Copy to .env and fill in. .env is gitignored.

# Adzuna (free): https://developer.adzuna.com/
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key
ADZUNA_COUNTRY=au

# Which model to score with (any LiteLLM string).
SCORING_MODEL=openrouter/deepseek/deepseek-chat

# Set the key for whichever provider your SCORING_MODEL uses.
# OpenRouter (one key, many models incl. free ones): https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key
# Or Gemini free tier: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_key
# Or DeepSeek direct: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=your_deepseek_key
